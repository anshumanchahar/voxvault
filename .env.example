# Rime API Configuration
RIME_API_KEY=your_rime_api_key_here
RIME_API_URL=https://users.rime.ai/v1

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Whisper.cpp Configuration
WHISPER_MODEL_PATH=models/ggml-base.en.bin

# Supabase Auth Configuration
# Set BOTH to store credentials in Supabase Auth.
# Get these from the Supabase dashboard:
#   Dashboard -> Project Settings -> API
#   SUPABASE_URL    = Project URL  (e.g. https://abcd1234.supabase.co)
#   SUPABASE_ANON_KEY = "anon public" key
# Leave EMPTY to use the local-dev fallback (data/users.json) instead.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secret used only by the local-dev fallback token signing (not Supabase).
AUTH_SECRET=voxvault-local-dev-secret

# Server Configuration
HOST=0.0.0.0
PORT=8000